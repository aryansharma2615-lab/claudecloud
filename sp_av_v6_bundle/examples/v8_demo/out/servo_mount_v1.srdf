<robot name="servo_mount_v1">
  <group name="arm">
    <joint name="shaft" />
  </group>
  <group_state name="level" group="arm">
    <joint name="shaft" value="0" />
  </group_state>
  <end_effector name="load" parent_link="arm_link" group="arm" />
  <disable_collisions link1="base_link" link2="arm_link" reason="Adjacent" />
  <disable_collisions link1="arm_link" link2="load_point" reason="Adjacent" />
</robot>