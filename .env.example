# Copy to .env on the farm PC. NEVER commit .env.
# 1 = fake printers (safe default). Set 0 only after the runbook's hardware steps pass.
FARM_DRY_RUN=1
FARM_DATA_DIR=C:\FarmHand\data
# Connected printers. Until the H2S arrives: ender
FARM_PRINTERS=ender

# --- Bambu H2S (printer screen: Settings > WLAN/Network > LAN Only + Developer Mode) ---
BAMBU_HOST=192.168.1.50
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=
# Where the printer finds the uploaded file. Test on day 1; alternative: ftp:///{name}
BAMBU_FILE_URL_TEMPLATE=file:///sdcard/{name}
# Dotted path to the door flag in the MQTT report, once Gate 1 Q2 is answered. Blank = unknown.
BAMBU_DOOR_FIELD=

# --- Ender via OctoPrint (API key of a user with PRINT but not CONTROL rights) ---
OCTOPRINT_URL=http://127.0.0.1:5000
OCTOPRINT_API_KEY=
ENDER_CAMERA_INDEX=0

# --- MCP server ---
FARM_HOST=127.0.0.1
FARM_PORT=8765
# Your Tailscale Funnel URL, no trailing slash, e.g. https://farmpc.tail1234.ts.net
FARM_PUBLIC_URL=
# GitHub OAuth app: callback URL = <FARM_PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The ONE GitHub username allowed to run the farm
FARM_ALLOWED_GITHUB_LOGIN=
# Long random string so logins survive restarts: python -c "import secrets;print(secrets.token_urlsafe(48))"
FARM_JWT_SIGNING_KEY=

# --- Alerts (pushover.net: create an application → token; your user key) ---
PUSHOVER_TOKEN=
PUSHOVER_USER=
